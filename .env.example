# ---- Server ----
PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=https://media.example.com
# Shown as the page title/wordmark. Defaults to "Marquee" if unset — set this to
# brand your own deployment (e.g. SITE_NAME=MyPlexHub).
SITE_NAME=Marquee
# Optional, pipe-separated. Cycles on the sign-in screen and shows one (picked at
# random per page load) as a small caption under the dashboard's own logo. Defaults
# to a single generic phrase if unset — give it your own personality, e.g. for a
# Skynet-named site: SITE_TAGLINES=Always watching.|Learning your patterns.|I'll be back with recommendations.
SITE_TAGLINES=
# Overrides the docker container's name (defaults to "marquee"). Only matters if you
# want a specific name in `docker ps`/your log viewer.
CONTAINER_NAME=marquee
# Host-side port for docker-compose (container always listens on 4000 internally).
# Point your reverse proxy/tunnel at this. Defaults to 4000 if unset.
HOST_PORT=4000
# Only mark this true once you're actually accessing the app over HTTPS (i.e. through
# a reverse proxy). Testing directly at http://host:4000 needs this OFF, or the
# browser silently refuses to store the session cookie.
COOKIE_SECURE=false

# ---- Plex (used for "Sign in with Plex" + Now Playing) ----
# Admin/owner token for YOUR plex server (Settings > ... or see Plex support docs "Finding an authentication token")
PLEX_ADMIN_TOKEN=
# Your Plex server's machine identifier (Settings > General, or from /identity endpoint)
PLEX_MACHINE_ID=
PLEX_SERVER_URL=http://localhost:32400
# A stable random UUID identifying this app to plex.tv (generate once, keep forever)
PLEX_CLIENT_ID=marquee-app-a1b2c3d4

# ---- Tautulli ----
TAUTULLI_URL=http://localhost:8181
TAUTULLI_API_KEY=
# Optional: split "Recently Added" into sections instead of one combined list.
# Find section IDs by hitting GET /api/tautulli/libraries once signed in.
TAUTULLI_SECTION_MOVIES=
TAUTULLI_SECTION_TV=
TAUTULLI_SECTION_ANIME=

# ---- Sonarr ----
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# ---- Radarr ----
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# ---- Overseerr / Jellyseerr ----
OVERSEERR_URL=http://localhost:5055
OVERSEERR_API_KEY=
# Powers the "Available now" toast. Generate a random string, put it here, then in
# Overseerr: Settings -> Notifications -> Webhook -> enable, Webhook URL =
# <PUBLIC_URL>/api/overseerr/webhook, Authorization Header = the same string, JSON
# Payload = leave as the default template. Only the "Request Available" notification
# type needs to be checked.
OVERSEERR_WEBHOOK_SECRET=
# Optional: if Overseerr's webhook was already pointed somewhere else before adding
# OVERSEERR_WEBHOOK_SECRET above (Overseerr only supports one webhook URL at a time),
# put that original URL here and every payload gets forwarded on unchanged so nothing
# else that relied on it breaks.
OVERSEERR_WEBHOOK_FORWARD_URL=

# ---- Prowlarr (owner-only indexer health on the admin page) ----
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=

# ---- Download Queue (both optional — leave a section's URL blank to skip it) ----
# qBittorrent has no API-key auth, only a real WebUI login. If its "bypass auth for
# whitelisted subnet" setting is on, that only covers requests that keep your LAN
# source IP — container-to-container traffic usually doesn't, so a real login is
# still needed here.
QBITTORRENT_URL=http://localhost:9080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
# Settings → General → check "API Key" in SABnzbd's web UI
SABNZBD_URL=http://localhost:8080
SABNZBD_API_KEY=

# ---- Owner-only status panel (optional — only shown to the server owner, never
# shared users). Leave blank to skip a source entirely. ----
# Uptime Kuma's data directory on the HOST (used by docker-compose.yml's volume
# mount) and the matching path INSIDE the container (used by the app) — both
# needed together.
UPTIME_KUMA_DATA_DIR=
UPTIME_KUMA_DB_PATH=/app/uptime-kuma-data/kuma.db
# Speaks NUT's (Network UPS Tools) protocol directly — this is whatever host runs
# upsd, not necessarily this Docker host. NUT_UPS_NAME is the device name as NUT
# knows it (`LIST UPS` on upsd, or check your NUT web UI if you have one).
NUT_HOST=
NUT_PORT=3493
NUT_USERNAME=
NUT_PASSWORD=
NUT_UPS_NAME=
